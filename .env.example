# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own keys before running the agent.
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
#
# Why three keys? Free-tier RPM caps make a single key the bottleneck for
# multi-agent runs. The client rotates through whatever you provide; one
# key is enough to start, three keeps a typical run smooth.
# ---------------------------------------------------------------------------

# Required (at least one):
GEMINI_API_KEY=AIzaSyC7xG4jiTtPTLiJP0d2wxRDajvIK4DW-yg

# Optional rotation pool:
# GEMINI_API_KEY_2=your-second-key
# GEMINI_API_KEY_3=your-third-key

# ---------------------------------------------------------------------------
# Optional model overrides. Defaults work for most users.
# ---------------------------------------------------------------------------
# FRACTURE_AGENT_PRIMARY_MODEL=gemini-2.5-pro
# FRACTURE_AGENT_FAST_MODEL=gemini-2.5-flash
# FRACTURE_AGENT_VISION_MODEL=gemini-2.5-pro
# FRACTURE_AGENT_EMBED_MODEL=gemini-embedding-001

# ---------------------------------------------------------------------------
# WSL / FEniCSx execution settings (Windows-only).
# ---------------------------------------------------------------------------
# FRACTURE_AGENT_CONDA_ENV=fenicsx
# FRACTURE_AGENT_MPI_DEFAULT=1
